{
  "cli": {
    "version": ">= 5.9.1",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "development": {
      "android": {
        "buildType": "apk",
        "developmentClient": true,
        "distribution": "internal"
      },
      "channel": "development"
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "channel": "production"
    }
  }
}
